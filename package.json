{
  "name": "ai-presenter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "probe:live": "node scripts/probe-live.mjs --max-seconds 45",
    "test:config": "node --test scripts/config.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs scripts/config.mjs",
    "test:browser": "playwright test --config tests/playwright.config.ts",
    "package": "node scripts/package.mjs",
    "verify:delivery": "node scripts/check-delivery.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
